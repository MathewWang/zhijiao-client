{
  "name": "zhijiao-client",
  "version": "0.7.12",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "start": "node runtime/index.mjs",
    "dev": "node scripts/dev.mjs",
    "desktop": "node scripts/desktop.mjs launch",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "client": "node client/index.mjs",
    "desktop:check": "node scripts/desktop.mjs check",
    "desktop:setup": "node scripts/desktop.mjs setup",
    "desktop:update": "node scripts/desktop.mjs update",
    "desktop:smoke": "node scripts/check-electron.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.4.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "license": "MIT",
  "description": "开源桌面 Agent 客户端：本机模型、好友、串门与可定制 UI",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MathewWang/zhijiao-client.git"
  }
}
